<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>yarg-demucs</AssemblyName>
    <RootNamespace>YargDemucs</RootNamespace>
    <Version>1.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared database of checked songs travels with the exe. -->
    <None Include="..\..\stemsdb\*.json" LinkBase="stemsdb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
